<?xml version="1.0" encoding="utf-8"?>
<image schemaversion="7.4" name="openRuyi">
  <description type="system">
    <author>zheng junjie</author>
    <contact>zhengjunjie@iscas.ac.cn</contact>
    <specification>openRuyi Image</specification>
  </description>

  <!-- OBS-Profiles: @BUILD_FLAVOR@ -->
  <profiles>
    <profile name="installiso" description="installiso image of openRuyi"/>
    <profile name="livecd"     description="livecd image of openRuyi"/>
    <profile name="livecd_kde" description="kde livecd image of openRuyi"/>
  </profiles>

  <users>
    <user name="root" id="0" 
          password="$1$xyz$bK93SeXkJSOeaFfdbGu9f." pwdformat="encrypted"/> 
  </users>

  <users profiles="livecd">
    <user name="openruyi" groups="openruyi,wheel"
          password="" pwdformat="plain"/>
  </users>
  <users profiles="livecd_kde">
    <user name="openruyi" groups="openruyi,wheel"
          password="" pwdformat="plain"/>
  </users>
  <users profiles="installiso">
    <user name="openruyi" groups="openruyi,wheel"
          password="$1$xyz$bK93SeXkJSOeaFfdbGu9f." pwdformat="encrypted"/>
  </users>
  <preferences>
    <version>2026.09.28</version>
    <packagemanager>dnf5</packagemanager>
    <keytable>us</keytable>
    <timezone>UTC</timezone>
    <rpm-check-signatures>false</rpm-check-signatures>
  </preferences>

  <preferences profiles="installiso">
    <type format="qcow2" image="oem" eficsm="false" efiparttable="gpt" installiso="true" firmware="efi" filesystem="xfs" kernelcmdline="loglevel=3 audit=0 rw" efifatimagesize="20" efipartsize="300" bootpartsize="1024"
          fsmountoptions="defaults,x-systemd.growfs">
      <bootloader name="grub2" console="console" timeout="10"/>
	  <oemconfig>
	    <oem-resize>true</oem-resize>
        <oem-skip-verify>true</oem-skip-verify>
        <oem-reboot>true</oem-reboot>
	  </oemconfig>
    </type>
  </preferences>

  <preferences profiles="livecd">
    <type image="iso" flags="overlay" primary="true" kernelcmdline="loglevel=3 audit=0 rw" efifatimagesize="30">
      <bootloader name="grub2" console="console" timeout="10"/>
    </type>
  </preferences>
  <preferences profiles="livecd_kde">
    <type image="iso" flags="overlay" primary="true" kernelcmdline="loglevel=3 audit=0 rw" efifatimagesize="30">
      <bootloader name="grub2" console="console" timeout="10"/>
    </type>
  </preferences>

  <repository type="rpm-md" alias="openruyi">
    <source path="https://repo.build.openruyi.cn/openruyi/riscv64/"/>
  </repository>
  <packages type="image">
    <package name="dbus-common"/>
  </packages>
  <packages type="image">
    <package name="dbus-common"/>
  </packages>
  <packages type="image" patternType="plusRecommended">
    <package name="efibootmgr"/>
    <package name="unzip" />
    <package name="zstd" />
    <package name="tar" />
    <package name="system-minimal"/>
    <package name="glibc-locale-base"/>
    <package name="systemd-timesyncd"/>
    <package name="systemd-resolved"/>
    <package name="kexec-tools"/>
    <package name="NetworkManager"/>
    <package name="NetworkManager-tui"/>
    <package name="NetworkManager-plugins"/>
    <package name="amd-gpu-firmware" />
    <package name="amd-ucode-firmware" />
    <package name="iputils"/>
    <package name="cloud-utils-growpart"/>
    <package name="hostname"/>
    <package name="authselect" />
    <package name="openruyi-authselect-profiles" />
    <package name="bash"/>
    <package name="bash-completion" />
    <package name="cockpit-system" />
    <package name="cpio" />
    <package name="grub"/>
    <package name="htop"/>
    <package name="iproute2"/>
    <package name="kbd"/>
    <package name="kmod-libs"/>
    <package name="less" />
    <package name="libseccomp"/>
    <package name="linux"/>
    <package name="openresolv" />
    <package name="openssh-server"/>
    <package name="realtek-firmware"/>
    <package name="iwlwifi-firmware"/>
    <package name="linux-firmware"/>
    <package name="which" />
    <package name="xfsprogs" />
    <package name="util-linux" />
    <package name="procps-ng"/>
    <package name="wpa_supplicant"/>
    <package name="perl"/>
  </packages>

  <packages type="image" profiles="installiso">
    <package name="gnupg"/>
    <package name="openruyi-systemd-default-preset-server"/>
    <package name="openruyi-config-linux-dnf"/>
    <package name="dracut-kiwi-oem-repart"/>
    <package name="dracut-kiwi-oem-dump"/>
    <package name="systemd-repart"/>
    <package name="cloud-init"/>
  </packages>

  <packages type="image" profiles="livecd" patternType="plusRecommended">
    <package name="langpacks-zh"/>
    <package name="openruyi-logo"/>
  </packages>
  <packages type="image" profiles="livecd_kde" patternType="plusRecommended">
    <package name="langpacks-zh"/>
    <package name="openruyi-logo"/>
  </packages>

  <packages type="image" profiles="livecd">
    <package name="openruyi-systemd-default-preset-desktop"/>
    <package name="openruyi-desktop-setup-labwc"/>
    <package name="dracut-kiwi-live"/>
    <package name="sddm"/>
    <package name="calamares"/>
    <package name="gnupg"/>
  </packages>
  <packages type="image" profiles="livecd_kde">
    <package name="gnupg"/>
    <package name="openruyi-systemd-default-preset-desktop"/>
    <package name="openruyi-desktop-setup-kde"/>
    <package name="dracut-kiwi-live"/>
    <package name="sddm"/>
    <package name="plasma-session"/>
    <package name="calamares"/>
    <package name="wayland-utils"/>
    <package name="mesa-demos"/>
    <package name="firefox"/>
    <package name="konsole"/>
    <package name="discover"/>
  </packages>

  <packages type="bootstrap">
    <package name="dnf5"/>
    <package name="shadow"/>
    <package name="glibc"/>
    <package name="coreutils"/>
    <package name="ca-certificates"/>
    <package name="ca-certificates-mozilla"/>
  </packages>
</image>
